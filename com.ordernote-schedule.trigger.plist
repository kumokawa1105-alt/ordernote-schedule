<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.ordernote-schedule.trigger</string>

    <!-- 毎日14:00にGitHub Actionsのdaily.ymlを起動（GitHubのscheduleは数時間遅れるため） -->
    <key>ProgramArguments</key>
    <array>
        <string>/Users/3years/ordernote-schedule/trigger.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/3years/ordernote-schedule</string>

    <!-- 14:00にMacがスリープ/オフでも、復帰・起動後に取りこぼしを実行する。
         14時前の起動はnotify.pyが送らず、送信済みの日はsent_dates.txtでスキップする。 -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key><integer>14</integer>
        <key>Minute</key><integer>0</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/3years/ordernote-schedule/launchd.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/3years/ordernote-schedule/launchd.log</string>

    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
